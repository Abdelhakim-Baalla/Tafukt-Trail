# Backend Environment Variables — copiez vers .env (jamais versionné)

# Server
PORT=5223
NODE_ENV=development

# Database (docker-compose fournit mongo:27017 ; local direct : mongodb://localhost:27017/tafukt_trail)
MONGO_URI=mongodb://localhost:27017/tafukt_trail

# JWT (OBLIGATOIRE, 32+ caractères aléatoires — le serveur refuse de démarrer sans)
JWT_SECRET=changez-moi-avec-une-chaine-aleatoire-de-32-caracteres-minimum

# CORS (origines autorisées, séparées par des virgules)
CORS_ORIGIN=http://localhost:5174,http://localhost:5173

# API
API_URL=http://localhost:5223
